# Midnight Network Environment Configuration

# Active Network: undeployed (local devnet), preview, or preprod
MIDNIGHT_NETWORK=undeployed

# RPC Node & Indexer endpoints
MIDNIGHT_NODE_URL=http://localhost:9944
MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v1/graphql
MIDNIGHT_INDEXER_WS_URL=ws://localhost:8088/api/v1/graphql/ws
MIDNIGHT_PROOF_SERVER_URL=http://localhost:6300

# Express Private Storage API
BACKEND_URL=http://localhost:5000/api
PORT=5000

# Contract Address (populated automatically after deployment, or set manually for testnets)
CONTRACT_ADDRESS=
